# This is an example environment variable file for the Payload CMS application.
# Copy this file to .env and fill in the values to configure your application.

#If running in devcontainer, the variables are set in the devcontainer.json file, so you can ignore the values here. If running locally, you will need to fill in the values.

# Database connection string
POSTGRES_URL=postgresql://user:password@localhost/website-db

# Used to configure CORS, format links and more. No trailing slash
FRONTEND_URL=http://localhost:3000

# Database connection string
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Used to validate webhook requests
REVALIDATE_SECRET=YOUR_SECRET_HERE

# Optional. reCAPTCHA v3 secret key. Leave unset to run without reCAPTCHA:
# submissions to forms with "Enable Recaptcha" ticked are accepted without
# verification and a warning is logged. The admin panel flags this on the
# checkbox, and the frontend hides the reCAPTCHA notice.
# The matching NEXT_PUBLIC_RECAPTCHA_SITE_KEY goes in apps/frontend/.env
RECAPTCHA_SECRET_KEY=

# Optional. Minimum v3 score to accept, 0.0-1.0. Defaults to 0.5.
RECAPTCHA_MIN_SCORE=0.5

# Optional. Form spam protection, defaults shown. Applies to every form, with or
# without reCAPTCHA. Submissions faster than FORM_MIN_FILL_MS are rejected, and
# each form accepts at most FORM_RATE_LIMIT_MAX submissions per
# FORM_RATE_LIMIT_WINDOW_MIN minutes (a global cap; no IPs are stored).
FORM_MIN_FILL_MS=3000
FORM_RATE_LIMIT_MAX=20
FORM_RATE_LIMIT_WINDOW_MIN=10
