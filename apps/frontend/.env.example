# Used to validate webhook requests
REVALIDATE_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_PAYLOAD_URL=http://localhost:3001

# Canonical site URL used for sitemap/robots.txt and SEO canonical tags. No trailing slash
# Falls back to VERCEL_PROJECT_PRODUCTION_URL, then https://example.com, if unset
NEXT_PUBLIC_SERVER_URL=

# Optional. reCAPTCHA v3 site key. Whether a form uses reCAPTCHA is decided by
# Payload (box ticked AND RECAPTCHA_SECRET_KEY set in apps/payload/.env), not by
# this key. Leave both unset to run without reCAPTCHA. If Payload has the secret
# but this is unset, forms with reCAPTCHA ticked are disabled with an error and
# the browser console names this variable.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=